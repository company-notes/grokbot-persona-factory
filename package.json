{
  "name": "grokbot-persona-factory",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.build.json",
    "test": "npm run build:test && node --test tests/*.test.mjs",
    "test:browser": "python tests/BrowserTest.py"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
