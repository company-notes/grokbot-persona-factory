{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grokbot-persona-factory",
  "main": "src/Index.ts",
  "compatibility_date": "2026-10-23",
  // This template intentionally has no custom-domain route.
  // To use your own hostname, add: "routes": [{ "pattern": "persona.example.com", "custom_domain": true }],
  // Or assign the custom domain from the Cloudflare dashboard.
  "assets": {
    "directory": "./public/web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENABLE_PUBLIC_GENERATION": "true",
    "PUBLIC_DAILY_CREDITS": "150"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "QUOTA_LEDGER", "class_name": "QuotaLedger" }
    ]
  },
  "migrations": [
    { "tag": "quota-ledger-v1", "new_sqlite_classes": ["QuotaLedger"] }
  ],
  "ratelimits": [
    {
      "name": "PERSONA_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
